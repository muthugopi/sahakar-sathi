// Sahakar Sathi — data model
// Vector search uses the pgvector extension; embedding columns are declared as
// Unsupported("vector(384)") and queried via raw SQL in the retrieval service.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations. Falls back to DATABASE_URL
  // via the config loader when not set. Required when DATABASE_URL points at a
  // PgBouncer/pooled endpoint (e.g. Neon's -pooler host).
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum UserRole {
  USER
  FARMER
  COOPERATIVE_MEMBER
  ADMIN
}

enum Language {
  en
  ta
  hi
}

enum MessageRole {
  user
  assistant
}

enum AnswerConfidence {
  HIGH
  MEDIUM
  LOW
  NO_SOURCE
}

enum KnowledgeCategory {
  COOPERATIVE_LAW
  BYLAWS
  GOVERNANCE
  MINISTRY_SCHEME
  PACS_SERVICE
  PMFBY_AGRICULTURE
  FINANCIAL_LITERACY
  GRIEVANCE_PROCESS
  MEMBER_SERVICE
  FAQ
}

enum GrievanceCategory {
  MEMBERSHIP
  LOAN_CREDIT
  DEPOSITS
  PACS_SERVICE
  CROP_INSURANCE
  SCHEME_BENEFIT
  GOVERNANCE_ELECTION
  CORRUPTION_MISCONDUCT
  OTHER
}

enum GrievanceStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum FeedbackRating {
  UP
  DOWN
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String?  @unique
  phone             String?  @unique
  passwordHash      String
  role              UserRole @default(USER)
  preferredLanguage Language @default(en)
  district          String?
  state             String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  conversations     Conversation[]
  grievances        Grievance[]
  feedback          Feedback[]
  refreshTokens     RefreshToken[]
  uploadedDocuments KnowledgeDocument[] @relation("DocumentUploader")
  assignedGrievances Grievance[]       @relation("GrievanceAssignee")
  grievanceEvents   GrievanceEvent[]
  auditLogs         AuditLog[]

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  language  Language  @default(en)
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String           @id @default(cuid())
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  role           MessageRole
  content        String
  language       Language
  confidence     AnswerConfidence?
  sources        Json?            // SourceRef[]
  disclaimers    Json?            // string[]
  createdAt      DateTime         @default(now())
  feedback       Feedback[]

  @@index([conversationId])
}

model Scheme {
  id                String            @id @default(cuid())
  slug              String            @unique
  title             String
  language          Language          @default(en)
  category          KnowledgeCategory @default(MINISTRY_SCHEME)
  summary           String
  purpose           String
  targetUsers       String[]
  eligibility       String
  benefits          String
  requiredDocuments String[]
  applicationProcess String
  officialSource    String
  officialUrl       String?
  state             String?           // null = national
  isVerified        Boolean           @default(false)
  verifiedAt        DateTime?
  isArchived        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([category])
  @@index([state])
}

model KnowledgeDocument {
  id            String            @id @default(cuid())
  title         String
  category      KnowledgeCategory
  authority     String            // e.g. "Ministry of Cooperation, GoI"
  sourceUrl     String?
  fileKey       String?           // path/key of the stored original
  language      Language          @default(en)
  version       Int               @default(1)
  isVerified    Boolean           @default(false)
  verifiedAt    DateTime?
  isPublished   Boolean           @default(false)
  uploadedBy    User?             @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  chunks        DocumentChunk[]

  @@index([category])
  @@index([isPublished, isVerified])
}

model DocumentChunk {
  id          String                       @id @default(cuid())
  document    KnowledgeDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId  String
  chunkIndex  Int
  content     String
  tokenCount  Int                          @default(0)
  embedding   Unsupported("vector(384)")?
  createdAt   DateTime                     @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model Grievance {
  id           String            @id @default(cuid())
  trackingId   String            @unique
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?
  category     GrievanceCategory
  description  String
  language     Language          @default(en)
  district     String?
  state        String?
  contactPhone String?
  status       GrievanceStatus   @default(SUBMITTED)
  assignedTo   User?             @relation("GrievanceAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  attachments  Attachment[]
  events       GrievanceEvent[]

  @@index([status])
  @@index([userId])
}

model GrievanceEvent {
  id          String          @id @default(cuid())
  grievance   Grievance       @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  grievanceId String
  status      GrievanceStatus
  note        String?
  actor       User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId     String?
  createdAt   DateTime        @default(now())

  @@index([grievanceId])
}

model Attachment {
  id          String     @id @default(cuid())
  grievance   Grievance? @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  grievanceId String?
  fileKey     String
  originalName String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime   @default(now())
}

model Feedback {
  id         String         @id @default(cuid())
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  message    Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId  String
  rating     FeedbackRating
  comment    String?
  createdAt  DateTime       @default(now())

  @@unique([userId, messageId])
  @@index([messageId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}
