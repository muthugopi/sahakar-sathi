# ---------------------------------------------------------------------------
# Sahakar Sathi - environment template
# Copy to .env at the repo root (used by docker compose) and to apps/api/.env
# NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- Database (Postgres + pgvector) ---
# Matches docker-compose.yml defaults. Change credentials for any real deploy.
POSTGRES_USER=sahakar
POSTGRES_PASSWORD=sahakar_dev_only
POSTGRES_DB=sahakar
DATABASE_URL=postgresql://sahakar:sahakar_dev_only@localhost:5432/sahakar?schema=public
# DIRECT_URL: non-pooled connection used only for `prisma migrate`. Set this when
# DATABASE_URL points at a pooled endpoint (e.g. Neon's "-pooler" host). For a
# plain local Postgres, leave it unset.
# DIRECT_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_me_access
JWT_REFRESH_SECRET=replace_me_refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Admin seed (used once by db:seed) ---
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=change_this_now

# --- LLM (Anthropic) ---
# Get a key at https://console.anthropic.com/ . Leave blank to use the mock adapter.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=1024

# --- Embeddings ---
# local  -> @xenova/transformers bge-small (no key, downloads ~90MB on first run)
# voyage -> Voyage AI hosted embeddings (needs VOYAGE_API_KEY)
EMBEDDINGS_PROVIDER=local
VOYAGE_API_KEY=

# --- Hybrid knowledge & web search ---
# Wikipedia (en/hi/ta) is always used as a secondary source for definitions and
# background — no key needed. Set WEB_SEARCH_API_KEY to also run a live general
# web search for "latest / current" questions (results carry a publish date).
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_MS=5000

# --- Speech (optional server fallback; browser Web Speech API is primary) ---
SPEECH_PROVIDER=browser

# --- File uploads ---
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=10

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
